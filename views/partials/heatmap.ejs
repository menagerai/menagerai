<%# `llm` (default false) turns each active-or-LLM cell into the tri-metric form:
    green square + red spend bar (left) + blue token bar (bottom). When false the
    partial renders exactly as the activity-only heatmap always has. %>
<% var llm = (typeof llm !== 'undefined' && llm); %>
<div class="heatmap" role="img" aria-label="<%= t('heatmap.aria', { days: heatmapDays }) %>">
  <% heatmap.weeks.forEach(function(week){ %>
    <div class="hm-col">
      <% week.forEach(function(c){ %>
        <% if (!c.day) { %>
          <%# padding cell — matches the day-cell size so columns stay aligned. %>
          <span class="hm-cell empty<%= llm ? ' llm' : '' %>"></span>
        <% } else if (llm) { %>
          <%# Every day is a 14px box (even empty ones), so the grid keeps stable
              whitespace around the 11px square and never goes wavy.
              --i/--ir/--ib are numbers from intensityFor (not user input). %>
          <span class="hm-cell llm<%= c.count ? ' on' : '' %>" title="<%= c.day %>: <%= c.count %><%= c.spend != null ? ` · $${(c.spend).toFixed(4)} · ${c.tokens} tok` : '' %>">
            <span class="sq"<%- c.count ? ` style="--i:${c.intensity}"` : '' %>></span>
            <% if (c.spend > 0) { %><span class="bar-v on" style="--ir:<%= c.spendIntensity %>;--lv:<%= c.spendIntensity / 100 %>"></span><% } %>
            <% if (c.tokens > 0) { %><span class="bar-h on" style="--ib:<%= c.tokenIntensity %>;--lb:<%= c.tokenIntensity / 100 %>"></span><% } %>
          </span>
        <% } else { %>
          <span class="hm-cell<%= c.count ? ' on' : '' %>"<%- c.count ? ` style="--i:${c.intensity}"` : '' %> title="<%= c.day %>: <%= c.count %>"></span>
        <% } %>
      <% }) %>
    </div>
  <% }) %>
</div>
<% if (typeof showLegend === 'undefined' || showLegend) { %>
<div class="hm-legend muted">
  <% if (llm) { %>
    <span class="sw"></span> <%= t('llm.legendSquare') %>
    · <span class="sw sw-red"></span> <%= t('llm.legendSpend') %>
    · <span class="sw sw-blu"></span> <%= t('llm.legendTokens') %>
  <% } else { %>
    <%= t('heatmap.less') %>
    <span class="hm-cell"></span><span class="hm-cell on" style="--i:0"></span><span class="hm-cell on" style="--i:33"></span><span class="hm-cell on" style="--i:66"></span><span class="hm-cell on" style="--i:100"></span>
    <%= t('heatmap.more', { days: heatmapDays }) %>
  <% } %>
</div>
<% } %>
