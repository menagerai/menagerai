<%# A compact metrics table: one column per window (recentDays / fullDays), one row
    per metric. `rows` is [{ label, color, recent, full }] where color is ''
    (activity), 'red' (spend) or 'blu' (tokens). The table grid aligns every figure
    automatically, replacing a run of per-metric window badges. An optional `llm`
    score ({ spendRecent, tokensRecent, spendFull, tokensFull }) appends the LLM
    spend and token rows, formatted here so every page shows them alike. %>
<%
  var _rows = rows.slice();
  if (typeof llm !== 'undefined' && llm) {
    // Spend to the cent; tokens rounded to 0.1M.
    var _spend = function (v) { return '$' + Number(v).toFixed(2); };
    var _tok = function (v) { return (Number(v) / 1e6).toFixed(1) + 'M'; };
    _rows.push({ label: t('llm.spend'), color: 'red', recent: _spend(llm.spendRecent), full: _spend(llm.spendFull) });
    _rows.push({ label: t('llm.tokens'), color: 'blu', recent: _tok(llm.tokensRecent), full: _tok(llm.tokensFull) });
  }
%>
<table class="score-table">
  <thead>
    <tr><th></th><th><%= recentDays %>d</th><th><%= fullDays %>d</th></tr>
  </thead>
  <tbody>
    <% _rows.forEach(function(r){ var cls = r.color ? ' val-' + r.color : ''; %>
      <tr>
        <th class="lbl<%= cls %>"><%= r.label %></th>
        <td class="<%= cls.trim() %>"><%= r.recent %></td>
        <td class="<%= cls.trim() %>"><%= r.full %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
