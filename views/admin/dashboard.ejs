<%
  // Exact width one full-window heatmap card needs, from its real column count:
  // cols × colW + (cols-1) gaps, + card padding (32) + border (2). A tri-metric
  // LLM cell is 14px (vs 11px) wide, so a column is 17px (14+3 gap) not 14px.
  var _appLlmOn = (typeof appLlmOn !== 'undefined' && appLlmOn);
  var _userLlmOn = (typeof userLlmOn !== 'undefined' && userLlmOn);
  var _llmWarning = (typeof llmWarning !== 'undefined' && llmWarning);
  var _w = (appCards[0] && appCards[0].heatmap.weeks.length)
        || (userCards[0] && userCards[0].heatmap.weeks.length) || 0;
  var _col = (_appLlmOn || _userLlmOn) ? 17 : 14;
  var _cardW = _w ? (_w * _col - 3 + 34) : 760;

  // Formatters for the LLM score rows. Tokens are rounded to 0.1M.
  function _spend(v){ return '$' + (v >= 1 ? v.toFixed(2) : v.toFixed(4)); }
  function _tok(v){ return (Number(v) / 1e6).toFixed(1) + 'M'; }
%>
<%- include('../partials/head', { title: t('dashboard.title'), user, isAdmin, wide: true, wrapStyle: '--card-w:' + _cardW + 'px' }) %>

<div class="page-head"><h1><%= t('dashboard.title') %></h1></div>
<p class="muted"><%= t('dashboard.intro', { n: topN, days: rankDays }) %></p>
<% if (_llmWarning) { %><p class="muted">⚠ <%= t('llm.timeout', { provider: 'LiteLLM' }) %></p><% } %>

<%
  // Section legend: tri-metric when any card in the section has LLM data, else the
  // familiar green activity ramp.
%>
<h2><%= t('dashboard.topApps') %></h2>
<% if (appCards.length === 0) { %>
  <p class="muted"><%= t('dashboard.noData') %></p>
<% } else { %>
  <div class="dash-legend hm-legend muted">
    <% if (_appLlmOn) { %>
      <span class="sw"></span> <%= t('llm.legendSquare') %>
      · <span class="sw sw-red"></span> <%= t('llm.legendSpend') %>
      · <span class="sw sw-blu"></span> <%= t('llm.legendTokens') %>
    <% } else { %>
      <%= t('heatmap.less') %>
      <span class="hm-cell"></span><span class="hm-cell on" style="--i:0"></span><span class="hm-cell on" style="--i:33"></span><span class="hm-cell on" style="--i:66"></span><span class="hm-cell on" style="--i:100"></span>
      <%= t('heatmap.more', { days: heatmapDays }) %>
    <% } %>
  </div>
  <div class="dash-grid">
    <% appCards.forEach(function(a){ %>
      <div class="card dash-card">
        <div class="dash-card-head">
          <a href="/admin/apps/<%= a.app_key %>"><%= a.name %></a>
          <code><%= a.app_key %></code>
        </div>
        <%
          var aRows = [{ label: t('dashboard.score'), color: 'grn', recent: a.active, full: a.scoreFull }];
          if (a.llm) {
            aRows.push({ label: t('llm.spend'), color: 'red', recent: _spend(a.llm.spendRecent), full: _spend(a.llm.spendFull) });
            aRows.push({ label: t('llm.tokens'), color: 'blu', recent: _tok(a.llm.tokensRecent), full: _tok(a.llm.tokensFull) });
          }
        %>
        <%- include('../partials/score-table', { recentDays: rankDays, fullDays: heatmapDays, rows: aRows }) %>
        <%- include('../partials/heatmap', { heatmap: a.heatmap, heatmapDays, showLegend: false, llm: _appLlmOn }) %>
      </div>
    <% }) %>
  </div>
<% } %>

<h2><%= t('dashboard.topUsers') %></h2>
<% if (userCards.length === 0) { %>
  <p class="muted"><%= t('dashboard.noData') %></p>
<% } else { %>
  <div class="dash-legend hm-legend muted">
    <% if (_userLlmOn) { %>
      <span class="sw"></span> <%= t('llm.legendSquare') %>
      · <span class="sw sw-red"></span> <%= t('llm.legendSpend') %>
      · <span class="sw sw-blu"></span> <%= t('llm.legendTokens') %>
    <% } else { %>
      <%= t('heatmap.less') %>
      <span class="hm-cell"></span><span class="hm-cell on" style="--i:0"></span><span class="hm-cell on" style="--i:33"></span><span class="hm-cell on" style="--i:66"></span><span class="hm-cell on" style="--i:100"></span>
      <%= t('heatmap.more', { days: heatmapDays }) %>
    <% } %>
  </div>
  <div class="dash-grid">
    <% userCards.forEach(function(u){ %>
      <div class="card dash-card">
        <div class="dash-card-head">
          <a href="/admin/users/<%= u.user_id %>"><%= u.email %></a>
          <% if (u.name) { %><code><%= u.name %></code><% } %>
        </div>
        <%
          var uRows = [{ label: t('dashboard.score'), color: 'grn', recent: u.active, full: u.scoreFull }];
          if (u.llm) {
            uRows.push({ label: t('llm.spend'), color: 'red', recent: _spend(u.llm.spendRecent), full: _spend(u.llm.spendFull) });
            uRows.push({ label: t('llm.tokens'), color: 'blu', recent: _tok(u.llm.tokensRecent), full: _tok(u.llm.tokensFull) });
          }
        %>
        <%- include('../partials/score-table', { recentDays: rankDays, fullDays: heatmapDays, rows: uRows }) %>
        <%- include('../partials/heatmap', { heatmap: u.heatmap, heatmapDays, showLegend: false, llm: _userLlmOn }) %>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/foot') %>
