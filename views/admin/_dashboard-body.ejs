<%
  // Dashboard body: intro, LLM warning and both card sections. Rendered inside
  // dashboard.ejs and on its own as the /admin/dashboard/llm fragment the page
  // swaps in once the LLM data arrives (via data-llm-src and the loader in
  // partials/foot). data-card-w carries the card width so the loader can resize
  // the page wrapper to match the swapped-in cards.
  var _appLlmOn = (typeof appLlmOn !== 'undefined' && appLlmOn);
  var _userLlmOn = (typeof userLlmOn !== 'undefined' && userLlmOn);
%>
<div class="dash-body" data-card-w="<%= cardW %>"<% if (typeof llmSrc !== 'undefined' && llmSrc) { %> data-llm-src="<%= llmSrc %>"<% } %>>
<% var _composite = (typeof compositeRanking !== 'undefined' && compositeRanking); %>
<p class="muted"><%= t(_composite ? 'dashboard.introComposite' : 'dashboard.intro', { n: topN, days: rankDays }) %></p>
<%- include('../partials/llm-status') %>

<h2><%= t('dashboard.topApps') %></h2>
<% if (appCards.length === 0) { %>
  <p class="muted"><%= t('dashboard.noData') %></p>
<% } else { %>
  <%- include('../partials/dash-legend', { llmOn: _appLlmOn }) %>
  <div class="dash-grid">
    <% appCards.forEach(function(a){ %>
      <div class="card dash-card">
        <div class="dash-card-head">
          <a href="/admin/apps/<%= a.app_key %>"><%= a.name %></a>
          <code><%= a.app_key %></code>
        </div>
        <%- include('../partials/heatmap', { heatmap: a.heatmap, heatmapDays, showLegend: false, llm: _appLlmOn }) %>
        <%- include('../partials/score-table', { recentDays: rankDays, fullDays: heatmapDays, rows: [{ label: t('dashboard.score'), color: 'grn', recent: a.active, full: a.scoreFull }], llm: a.llm }) %>
      </div>
    <% }) %>
  </div>
<% } %>

<h2><%= t('dashboard.topUsers') %></h2>
<% if (userCards.length === 0) { %>
  <p class="muted"><%= t('dashboard.noData') %></p>
<% } else { %>
  <%- include('../partials/dash-legend', { llmOn: _userLlmOn }) %>
  <div class="dash-grid">
    <% userCards.forEach(function(u){ %>
      <div class="card dash-card">
        <div class="dash-card-head">
          <a href="/admin/users/<%= u.user_id %>"><%= u.email %></a>
          <% if (u.name) { %><code><%= u.name %></code><% } %>
        </div>
        <%- include('../partials/heatmap', { heatmap: u.heatmap, heatmapDays, showLegend: false, llm: _userLlmOn }) %>
        <%- include('../partials/score-table', { recentDays: rankDays, fullDays: heatmapDays, rows: [{ label: t('dashboard.score'), color: 'grn', recent: u.active, full: u.scoreFull }], llm: u.llm }) %>
      </div>
    <% }) %>
  </div>
<% } %>
</div>
