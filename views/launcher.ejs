<%- include('partials/head', { title: t('nav.brand'), user, isAdmin }) %>

<h1><%= t('launcher.welcome', { name: user.name || user.email }) %></h1>
<p class="muted"><%= t('launcher.yourApps') %></p>

<% if (sections.length === 0) { %>
  <div class="card"><%= t('launcher.noApps') %></div>
<% } else { %>
  <%# A single untitled section (key '') is the plain flat grid; otherwise each
      section is a collapsible app group, open by default. %>
  <% var grouped = sections[0].key !== ''; %>
  <% sections.forEach(function(s) { %>
    <% if (grouped) { %>
      <details class="app-group" open data-group="<%= s.key %>"><summary><%= s.key === '_other' ? t('launcher.otherGroup') : s.name %> <span class="muted">(<%= s.apps.length %>)</span></summary>
    <% } %>
    <div class="grid">
      <% s.apps.forEach(function(a) { %>
        <a class="app-tile" href="<%= a.url %>" target="_blank" rel="noopener">
          <div><strong><%= a.name %></strong></div>
          <% if (a.description) { %><div class="desc"><%= a.description %></div><% } %>
        </a>
      <% }) %>
    </div>
    <% if (grouped) { %></details><% } %>
  <% }) %>
  <% if (grouped) { %>
    <script>
      // Remember which groups this browser collapsed (a per-viewer convenience;
      // storage may be unavailable, in which case everything just stays open).
      (function () {
        var KEY = 'menagerai.collapsedGroups';
        var collapsed = [];
        try { collapsed = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
        if (!Array.isArray(collapsed)) collapsed = [];
        document.querySelectorAll('details.app-group').forEach(function (d) {
          var k = d.getAttribute('data-group');
          if (collapsed.indexOf(k) !== -1) d.removeAttribute('open');
          d.addEventListener('toggle', function () {
            var i = collapsed.indexOf(k);
            if (d.open && i !== -1) collapsed.splice(i, 1);
            else if (!d.open && i === -1) collapsed.push(k);
            try { localStorage.setItem(KEY, JSON.stringify(collapsed)); } catch (e) {}
          });
        });
      })();
    </script>
  <% } %>
<% } %>

<%- include('partials/foot') %>
